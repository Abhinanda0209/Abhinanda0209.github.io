  var n=Math.round(Math.min(160,W*H/9000));specks=[];for(var i=0;i<n;i++)specks.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.3+.5,a:Math.random()*.35+.15,v:Math.random()*.3+.1,ph:Math.random()*6.3,blue:Math.random()<.35})}
function shoot(){shots.push({x:Math.random()*W*.6,y:Math.random()*H*.4,t:0})}
var last=performance.now();
function frame(now){var dt=Math.min(.05,(now-last)/1000);last=now;ctx.clearRect(0,0,W,H);
  specks.forEach(function(s){s.x-=s.v*60*dt;s.y+=s.v*.8*60*dt;
    if(s.x<-10||s.y>H+10){if(Math.random()<.5){s.x=W+Math.random()*100;s.y=Math.random()*H}else{s.x=Math.random()*W;s.y=-Math.random()*100}}
    var tw=.55+.45*Math.sin(now/1000*2.1+s.ph);ctx.fillStyle=s.blue?'rgba(17,108,202,'+(s.a*tw*1.4)+')':'rgba(60,56,48,'+(s.a*tw)+')';ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,6.3);ctx.fill()});
  if(now>nextShot){shoot();nextShot=now+2800+Math.random()*2200}
  shots.forEach(function(k){k.t+=dt;var p=Math.min(1,k.t/1.1),e=1-Math.pow(1-p,3),x=k.x+e*650,y=k.y+e*650,al=1-p;
    var g=ctx.createLinearGradient(x,y,x-60,y-60);g.addColorStop(0,'rgba(17,108,202,'+al+')');g.addColorStop(1,'rgba(17,108,202,0)');
    ctx.strokeStyle=g;ctx.lineWidth=2;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x-60,y-60);ctx.stroke();
    ctx.fillStyle='rgba(17,108,202,'+al+')';ctx.beginPath();ctx.arc(x,y,1.8,0,6.3);ctx.fill()});
  shots=shots.filter(function(k){return k.t<1.1});
  requestAnimationFrame(frame)}
size();addEventListener('resize',size);requestAnimationFrame(frame);
})();

/* 3D tilt on hover, like the destination cards */
if(!reduce&&matchMedia('(hover:hover)').matches){
  document.querySelectorAll('.show,.about .pic,.chat,.job').forEach(function(el){el.classList.add('tilt');var max=el.classList.contains('job')?2.5:6;
    el.addEventListener('pointermove',function(e){var r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;el.classList.add('tilting');el.style.transform='perspective(900px) rotateY('+(x*max)+'deg) rotateX('+(-y*max)+'deg) scale(1.01)'});
    el.addEventListener('pointerleave',function(){el.classList.remove('tilting');el.style.transform=''})});
}

/* Paper plane with a particle trail when you press Contact me */
(function(){var b=document.getElementById('launch');if(!b||reduce||!Element.prototype.animate)return;
b.addEventListener('click',function(ev){ev.preventDefault();var r=b.getBoundingClientRect(),sx=r.right-10,sy=r.top+r.height/2;
  var pl=document.createElement('div');pl.className='plane';pl.innerHTML='<svg viewBox="0 0 24 24" width="34" height="34"><path d="M2 11.5 22 3l-7.5 18-3.2-7.3z" fill="#116CCA"/><path d="M11.3 13.7 22 3" stroke="#fff" stroke-width="1.2"/><path d="M11.3 13.7 12 20l2.5-2.8" fill="#0B4F96"/></svg>';document.body.appendChild(pl);
  var ex=innerWidth+60,ey=-60,cx=sx+(ex-sx)*.35,cy=sy+120,dur=1600,t0=performance.now();
  function pt(t){var u=1-t;return [u*u*sx+2*u*t*cx+t*t*ex,u*u*sy+2*u*t*cy+t*t*ey]}
  (function step(now){var t=Math.min(1,(now-t0)/dur),e=t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2,p=pt(e),q=pt(Math.min(1,e+.01)),ang=Math.atan2(q[1]-p[1],q[0]-p[0])*180/Math.PI+22;
    pl.style.transform='translate('+(p[0]-17)+'px,'+(p[1]-17)+'px) rotate('+ang+'deg)';
    if(Math.random()<.7){var s=document.createElement('div');s.className='spark';s.style.background=Math.random()<.5?'radial-gradient(circle,#F2C94C,#F2A93B,transparent)':'radial-gradient(circle,#7FB3F0,#116CCA,transparent)';document.body.appendChild(s);
      s.animate([{transform:'translate('+p[0]+'px,'+p[1]+'px) scale(1)',opacity:.9},{transform:'translate('+(p[0]-40-Math.random()*50)+'px,'+(p[1]+10+Math.random()*30)+'px) scale(.4)',opacity:0}],{duration:900,easing:'ease-out'}).onfinish=function(){s.remove()}}
    if(t<1)requestAnimationFrame(step);else pl.remove()})(t0);
  setTimeout(function(){document.querySelector('#contact').scrollIntoView({behavior:'smooth'})},500);
})})();

})();
</script>
