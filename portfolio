<style>
:root{
  --bg:#F5F4F0; --white:#FFFFFF; --ink:#1C1C1E; --text:#4A4A4F; --muted:#8A8A90;
  --line:#E4E2DC; --accent:#116CCA; --accent-2:#E8F1FB; --dark:#1C1C1E; --green:#2E9E57;
  --sans:"Plus Jakarta Sans","Segoe UI",system-ui,-apple-system,sans-serif;
  --hand:"Caveat","Segoe Print","Comic Sans MS",cursive;
  --shadow:0 1px 2px rgba(20,20,20,.05),0 8px 24px -12px rgba(20,20,20,.18);
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 96px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:var(--accent)}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:8px}
.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
.narrow{max-width:760px}
h2{font-weight:800;font-size:clamp(1.9rem,4vw,2.6rem);letter-spacing:-.035em;line-height:1.1;margin:0 0 10px;text-align:center}
.h-sub{text-align:center;color:var(--muted);margin:0 auto 44px;max-width:52ch}
section{padding:96px 0}
section.white{background:var(--white)}

/* Nav */
.navwrap{position:sticky;top:0;z-index:20;padding:calc(env(safe-area-inset-top,0px) + 14px) 16px 0;margin-top:calc(-1 * env(safe-area-inset-top,0px));pointer-events:none}
.nav{pointer-events:auto;max-width:820px;margin:0 auto;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;padding:8px 8px 8px 10px}
.logo{background:var(--accent);color:#fff;font-weight:800;text-decoration:none;padding:5px 12px;border-radius:9px;font-size:.98rem;letter-spacing:-.02em;box-shadow:inset 0 -2px 0 rgba(0,0,0,.18)}
.nav nav{display:flex;gap:2px;margin:0 auto}
.nav nav a{color:var(--text);text-decoration:none;font-size:.93rem;font-weight:500;padding:6px 12px;border-radius:8px}
.nav nav a:hover,.nav nav a.on{background:var(--bg);color:var(--ink)}
.btn-dark{display:inline-flex;align-items:center;gap:8px;background:var(--dark);color:#fff;text-decoration:none;border:0;border-radius:10px;padding:9px 16px;font-weight:600;font-size:.93rem;box-shadow:inset 0 -2px 0 rgba(255,255,255,.08),0 6px 16px -8px rgba(0,0,0,.5);transition:transform .15s}
.btn-dark:hover{transform:translateY(-1px)}
.btn-dark svg{transition:transform .2s}
.btn-dark:hover svg{transform:translateX(3px)}
.btn-light{display:inline-flex;align-items:center;gap:8px;background:var(--white);color:var(--ink);text-decoration:none;border:1px solid var(--line);border-radius:10px;padding:9px 16px;font-weight:600;font-size:.93rem;box-shadow:var(--shadow)}
@media (max-width:420px){.hey{font-size:.8rem}.nav .btn-dark{padding:8px 12px}}
@media (max-width:720px){.nav nav{display:none}.nav{justify-content:space-between}}

/* Hero */
.hero{position:relative;text-align:center;padding:70px 0 110px;overflow:hidden}
.pattern{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.hero::after{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(38% 42% at 50% 52%,rgba(245,244,240,.85),rgba(245,244,240,0) 70%)}
.hero{background:transparent}
.hero .wrap{position:relative;z-index:1}
.avatar{width:168px;height:156px;margin:0 auto 26px;background:#FFF8EE;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden;animation:bob 6s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-6px)}}
.hey{display:inline-flex;align-items:center;gap:8px;background:var(--white);border:1px solid var(--line);border-radius:9px;padding:4px 10px 4px 5px;font-size:.88rem;color:var(--text);box-shadow:var(--shadow);margin-bottom:22px}
.hey b{color:var(--ink);font-weight:700}
.hey .tag{background:var(--accent-2);color:var(--accent);border-radius:6px;padding:1px 7px;font-weight:700;font-size:.78rem}
h1{font-weight:800;font-size:clamp(2.3rem,6.2vw,4.3rem);letter-spacing:-.045em;line-height:1.05;margin:0 auto 20px;max-width:18ch}
.hand{font-family:var(--hand);font-weight:700;letter-spacing:0;color:var(--accent);font-size:1.12em;display:inline-grid;vertical-align:baseline;height:1.05em;overflow:hidden;text-align:center}
.hand span{grid-area:1/1;transform:translateY(100%);opacity:0;transition:transform .55s cubic-bezier(.3,.9,.3,1),opacity .35s;line-height:1.05}
.hand span.in{transform:none;opacity:1}
.hand span.out{transform:translateY(-100%);opacity:0}
.lead{color:var(--text);font-size:1.08rem;max-width:48ch;margin:0 auto 30px}
.cta{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.status{display:inline-flex;align-items:center;gap:8px;margin-top:26px;font-size:.88rem;color:var(--muted)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(46,158,87,.5);animation:ping 2s infinite}
@keyframes ping{70%{box-shadow:0 0 0 8px rgba(46,158,87,0)}100%{box-shadow:0 0 0 0 rgba(46,158,87,0)}}
.status b{color:var(--ink);font-weight:600}

/* About */
.about{display:grid;grid-template-columns:320px 1fr;gap:56px;align-items:center}
.about .pic{background:#F1EDE4;border-radius:14px;aspect-ratio:4/5;overflow:hidden;box-shadow:var(--shadow)}
.about h2{text-align:left;margin-bottom:0}
.about .aside{font-family:var(--hand);font-size:1.6rem;color:var(--muted);margin:0 0 20px;line-height:1.1}
.about p{color:var(--text);margin:0 0 16px;max-width:56ch}
.facts{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 26px;padding:0;list-style:none}
.facts li{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:4px 10px;font-size:.86rem;color:var(--text)}
.facts b{color:var(--ink)}
@media (max-width:780px){.about{grid-template-columns:1fr;gap:32px}.about .pic{max-width:300px;margin:0 auto}}

/* Experience */
.jobs{display:grid;gap:16px}
.job{background:var(--white);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}
.job>button{width:100%;text-align:left;background:none;border:0;padding:22px 24px;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center}
.logo-sq{width:42px;height:42px;border-radius:10px;display:grid;place-items:center;font-weight:800;color:#fff;font-size:.95rem}
.job h3{margin:0;font-size:1.12rem;letter-spacing:-.02em}
.job .meta{color:var(--muted);font-size:.9rem}
.job .when{font-size:.85rem;color:var(--text);background:var(--bg);border-radius:7px;padding:3px 9px;white-space:nowrap}
.job .summary{padding:0 24px 20px 82px;margin:-8px 0 0;color:var(--text)}
.more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .4s cubic-bezier(.2,.8,.2,1)}
.job.open .more{grid-template-rows:1fr}
.more>div{overflow:hidden}
.more ul{margin:0;padding:0 24px 22px 100px;color:var(--text)}
.more li{margin-bottom:6px}
.toggle{display:inline-flex;align-items:center;gap:6px;margin:0 0 18px 82px;font-size:.88rem;font-weight:600;color:var(--accent);background:none;border:0;padding:0}
.toggle svg{transition:transform .3s}
.job.open .toggle svg{transform:rotate(180deg)}
@media (max-width:620px){.job>button{grid-template-columns:auto 1fr}.job .when{grid-column:2;justify-self:start}.job .summary,.toggle{margin-left:24px;padding-left:0}.job .summary{padding:0 24px 16px}.more ul{padding-left:42px}}

/* Projects showcase */
.tabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:0 0 22px}
.tab{border:1px solid var(--line);background:var(--white);border-radius:10px;padding:8px 14px;font-weight:600;font-size:.92rem;color:var(--text);box-shadow:var(--shadow)}
.tab[aria-selected="true"]{background:var(--dark);border-color:var(--dark);color:#fff}
.show{background:radial-gradient(120% 90% at 100% 0,#2A2F3A,#15171C 60%);color:#fff;border-radius:20px;padding:34px;display:grid;grid-template-columns:1.1fr 1fr;gap:34px;align-items:center;box-shadow:0 30px 60px -30px rgba(0,0,0,.6);min-height:340px}
.show .screen{background:#F7F6F2;border-radius:12px;padding:14px;aspect-ratio:16/11;display:grid;place-items:center}
.show .screen svg{width:100%;height:100%}
.show h3{margin:0 0 6px;font-size:1.55rem;letter-spacing:-.03em;line-height:1.15}
.show .kind{color:#A9B0BD;font-size:.9rem;margin:0 0 16px}
.show p{color:#D5D9E0;margin:0 0 14px}
.show ul{margin:0 0 18px;padding-left:1.1em;color:#D5D9E0}
.show li{margin-bottom:5px}
.pills{display:flex;flex-wrap:wrap;gap:6px;list-style:none;padding:0;margin:0}
.pills li{border:1px solid #3A404C;background:#22262E;border-radius:6px;padding:2px 8px;font-size:.8rem;color:#E4E7EC;margin:0}
.fadein{animation:fade .45s cubic-bezier(.2,.8,.2,1)}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media (max-width:780px){.show{grid-template-columns:1fr;padding:22px}}

/* Skills table */
.table{background:var(--white);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}
.row{display:grid;grid-template-columns:170px 1fr;border-top:1px dashed var(--line)}
.row:first-child{border-top:0;background:#FAFAF8;font-size:.82rem;color:var(--muted);font-weight:600}
.row>div{padding:14px 18px}
.row .cat{font-size:1.02rem;color:var(--text);font-weight:500}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--line);background:var(--bg);border-radius:7px;padding:3px 10px;font-size:.86rem;color:var(--ink);transition:background .15s,border-color .15s,transform .15s}
.chip:hover{border-color:var(--accent);transform:translateY(-1px)}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}
.where{margin-top:16px;min-height:56px;background:var(--white);border:1px solid var(--line);border-radius:12px;padding:14px 18px;color:var(--text);font-size:.95rem;box-shadow:var(--shadow)}
.where b{color:var(--ink)}
@media (max-width:620px){.row{grid-template-columns:1fr}.row>div.cat{padding-bottom:0}.row:first-child{display:none}}

.contactwrap{max-width:380px;margin:0 auto}
.chat{background:var(--white);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:26px;text-align:center}
.chat .mini{width:64px;height:64px;border-radius:50%;margin:0 auto 12px;background:#FFF8EE;border:1px solid var(--line);overflow:hidden}
.chat h3{margin:0 0 6px;font-size:1.1rem;letter-spacing:-.02em}
.chat p{margin:0 0 18px;color:var(--muted);font-size:.9rem}
.chat .stack{display:grid;gap:8px}
.chat .btn-light,.chat .btn-dark{justify-content:center}
.copied{background:#E8F5EC!important;border-color:#A8D8B6!important}
.qa{display:grid;gap:10px}
.q{background:var(--white);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}
.q>button{width:100%;background:none;border:0;text-align:left;padding:16px 18px;display:flex;justify-content:space-between;gap:12px;font-weight:600;font-size:.98rem}
.q .pm{flex:none;width:22px;height:22px;border-radius:6px;background:var(--bg);display:grid;place-items:center;transition:transform .3s,background .3s}
.q.open .pm{transform:rotate(45deg);background:var(--accent-2);color:var(--accent)}
.q .a{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s cubic-bezier(.2,.8,.2,1)}
.q.open .a{grid-template-rows:1fr}
.q .a>div{overflow:hidden}
.q .a p{margin:0;padding:0 18px 16px;color:var(--text);font-size:.95rem}


footer{padding:36px 0 44px;border-top:1px solid var(--line);color:var(--muted);font-size:.88rem}
footer .wrap{display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between}
footer a{color:var(--text);text-decoration:none;margin-left:16px}

.reveal{opacity:0;transform:translateY(16px);transition:opacity .6s,transform .6s cubic-bezier(.2,.8,.2,1)}
.reveal.seen{opacity:1;transform:none}
.blink{animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.steam{animation:steam 3s ease-in-out infinite;transform-origin:bottom}
@keyframes steam{0%,100%{opacity:.2;transform:translateY(2px)}50%{opacity:.8;transform:translateY(-3px)}}

/* Effects borrowed from Good_UI, adapted to a light theme */
#sky{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
section,header.hero,footer{position:relative;z-index:1}
section.white{background:rgba(255,255,255,.82)}
.hand span{background:linear-gradient(90deg,#0E5BAA,#4C9BEA,#116CCA,#0E5BAA);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:glowShift 5s ease-in-out infinite alternate;filter:drop-shadow(0 0 10px rgba(17,108,202,.25))}
@keyframes glowShift{from{background-position:0% 50%}to{background-position:100% 50%}}
.dance .w{display:inline-block;white-space:nowrap}
.dance .l{display:inline-block;transition:transform .3s}
h1:hover .dance .l{animation:wiggle .6s infinite alternate}
.dance .l:nth-child(odd){animation-delay:.1s}.dance .l:nth-child(even){animation-delay:.2s}
@keyframes wiggle{0%{transform:none}50%{transform:translateY(-6px) rotate(3deg)}100%{transform:none}}
.bounce-slow{animation:bounceSlow 2.5s ease-in-out infinite}
@keyframes bounceSlow{50%{transform:translateY(-4px)}}
.tilt{transition:transform .35s ease,box-shadow .35s ease;transform-style:preserve-3d;will-change:transform}
.tilt.tilting{box-shadow:0 24px 50px -24px rgba(17,108,202,.35)}
.plane{position:fixed;z-index:40;width:34px;height:34px;pointer-events:none;left:0;top:0}
.spark{position:fixed;z-index:39;width:6px;height:6px;border-radius:50%;pointer-events:none;left:0;top:0}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style>
</head>
